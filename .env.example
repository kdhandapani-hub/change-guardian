# Copy to .env (ignored by Git). Never put API keys in chat.
GUARDIAN_MODEL_BASE_URL=https://api.fireworks.ai/inference/v1
GUARDIAN_MODEL=accounts/fireworks/models/kimi-k3
GUARDIAN_MODEL_API_KEY=
# Optional locally; Replit tracing is enabled once its private LangSmith key is configured.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=change-guardian
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required for keys scoped to multiple workspaces; use your actual workspace ID.
LANGSMITH_WORKSPACE_ID=

# Optional remote execution host; defaults preserve laptop-only mode.
GUARDIAN_JENKINS_BASE_URL=http://127.0.0.1:8088
GUARDIAN_JENKINS_READER_FILE=runtime/jenkins-reader.json
GUARDIAN_JENKINS_WRITER_FILE=runtime/jenkins-writer.json

# For authenticated ngrok only; in Replit use Secrets for GUARDIAN_GATEWAY_SECRET.
GUARDIAN_GATEWAY_SECRET=
# Local alternative: owner-only file containing the gateway secret.
GUARDIAN_GATEWAY_SECRET_FILE=

# Cloud-only: set in Replit Secrets, never in source files.
GUARDIAN_JENKINS_READER_JSON=
GUARDIAN_JENKINS_WRITER_JSON=
GUARDIAN_PUBLIC_ORIGIN=
GUARDIAN_APP_PASSWORD=
DATABASE_URL=

# New agent-based workspaces: obtain these from your LangSmith agent setup.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=local
