  "item": [
    {
      "name": "accounts/health",
      "item": [
        {
          "name": "accounts/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Synthetic response\", () => pm.expect(pm.response.json().synthetic).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
